@model List<Booking>
@{ ViewData["Title"] = "Booking Requests"; }
<h2>Booking requests</h2>
<table class="table align-middle"><thead><tr><th>Guest</th><th>Property</th><th>Dates</th><th>Total</th><th>Status</th><th></th></tr></thead><tbody>
@foreach (var b in Model) { <tr><td>@b.Guest.FullName<br/><small>@b.Guest.Email</small></td><td>@b.Property.Title</td><td>@b.CheckInDate.ToString("dd MMM") – @b.CheckOutDate.ToString("dd MMM")</td><td>R @b.TotalPrice.ToString("N2")</td><td>@b.Status</td>
<td>@if (b.Status == BookingStatus.Pending) { <form asp-action="Decide" method="post" class="d-inline"><input type="hidden" name="id" value="@b.Id"/><button name="approve" value="true" class="btn btn-sm btn-success">Approve</button> <button name="approve" value="false" class="btn btn-sm btn-outline-danger">Reject</button></form> }</td></tr> }
</tbody></table>
