@using System.Security.Claims
@inject Staybnb.Data.ApplicationDbContext Db
@{
    var uid = User.FindFirstValue(ClaimTypes.NameIdentifier);
    int unread = 0, msgs = 0;
    if (uid != null) { unread = Db.Notifications.Count(n => n.UserId == uid && !n.IsRead); msgs = Db.Messages.Count(m => m.ReceiverId == uid && !m.IsRead); }
}
<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
<title>@ViewData["Title"] - Staybnb</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"/>
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet"/>
<style>:root{--brand:#ff385c}.btn-brand{background:var(--brand);color:#fff;border:0}.btn-brand:hover{background:#e0304f;color:#fff}.brand{color:var(--brand);font-weight:700}
.card-img-top{height:220px;object-fit:cover;border-radius:14px}.prop-card{border:0}</style></head>
<body>
<nav class="navbar navbar-expand-lg bg-white border-bottom"><div class="container">
  <a class="navbar-brand brand" asp-controller="Home" asp-action="Index"><i class="bi bi-house-heart"></i> staybnb</a>
  <button class="navbar-toggler" data-bs-toggle="collapse" data-bs-target="#nav"><span class="navbar-toggler-icon"></span></button>
  <div class="collapse navbar-collapse" id="nav"><ul class="navbar-nav me-auto">
    @if (User.IsInRole("Guest")) { <li class="nav-item"><a class="nav-link" asp-controller="Guest" asp-action="Bookings">My Bookings</a></li>
      <li class="nav-item"><a class="nav-link" asp-controller="Apply" asp-action="Create">Become a Host</a></li>
      <li class="nav-item"><a class="nav-link" asp-controller="Apply" asp-action="Status">Host Application Status</a></li> }
    @if (User.IsInRole("Host")) { <li class="nav-item"><a class="nav-link" asp-controller="Host" asp-action="Dashboard">Dashboard</a></li>
      <li class="nav-item"><a class="nav-link" asp-controller="Host" asp-action="Properties">My Properties</a></li>
      <li class="nav-item"><a class="nav-link" asp-controller="Host" asp-action="Bookings">Booking Requests</a></li>
      <li class="nav-item"><a class="nav-link" asp-controller="Host" asp-action="CheckIns">Check-ins</a></li>
      <li class="nav-item"><a class="nav-link" asp-controller="Apply" asp-action="Create">Add Property</a></li> }
    @if (User.IsInRole("Admin") || User.IsInRole("SuperAdmin")) { <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Dashboard">Dashboard</a></li>
      <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Applications">Host Requests</a></li>
      @if (User.IsInRole("SuperAdmin")) { <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Users">Users</a></li> }
      <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Logs">Activity Logs</a></li> }
  </ul><ul class="navbar-nav align-items-lg-center">
    @if (User.Identity.IsAuthenticated) {
      <li class="nav-item"><a class="nav-link" asp-controller="Messages" asp-action="Index"><i class="bi bi-envelope"></i> @if (msgs > 0) { <span class="badge bg-danger">@msgs</span> }</a></li>
      <li class="nav-item"><a class="nav-link" asp-controller="Notifications" asp-action="Index"><i class="bi bi-bell"></i> @if (unread > 0) { <span class="badge bg-danger">@unread</span> }</a></li>
      <li class="nav-item"><form asp-controller="Account" asp-action="Logout" method="post"><button class="btn btn-link nav-link">Logout (@User.Identity.Name)</button></form></li>
    } else { <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Login">Login</a></li><li class="nav-item"><a class="btn btn-brand btn-sm" asp-controller="Account" asp-action="Register">Sign up</a></li> }
  </ul></div></div></nav>
<main class="container py-4">
  @if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }
  @if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> }
  @RenderBody()
</main>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body></html>
